APP_NAME="Laravel Store API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# MySQL en Docker: docker compose up -d
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=db_store
DB_USERNAME=db_store
DB_PASSWORD=secret

# API stateless: sin tablas de sesiones ni de colas
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
